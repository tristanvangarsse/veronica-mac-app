  "video_frame_rate_tolerance_fraction": 0.01,
  "video_max_storage_edge": 1280,
  "video_review_hdr": true,
  "video_review_extra_streams": true,
  "video_review_vfr": true,
  "video_vfr_min_timing_intervals": 10,
