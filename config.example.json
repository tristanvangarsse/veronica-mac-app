{
  "archive_age_years": 2,
  "legacy_processing_tags": [
    "compressed-v1",
    "compressed-v2",
    "_compressed-v2"
  ],
  "legacy_v2_tags": [
    "compressed-v2",
    "_compressed-v2"
  ],
  "personal_tags_exclude": [
    "compressed-v1",
    "compressed-v2",
    "_compressed-v2",
    "temp-1",
    "temp-2"
  ],
  "ignore_names": [
    ".DS_Store"
  ],
  "roots": {},
  "audio_min_size_mb": 10,
  "video_preset_file": "preset-720P.json",
  "policies": {
    "streams_video": "streams-video-handbrake-square-pixel-720p-v4-no-autocrop",
    "streams_audio": "streams-audio-mp3-128k-v1",
    "image": "image-folder-recipe-v2"
  },
  "minimum_saving_percent": 10.0,
  "minimum_saving_bytes": 1048576,
